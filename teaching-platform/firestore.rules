rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function instructor() { return request.auth != null && request.auth.token.email_verified == true && request.auth.token.email == 'statoberry@gmail.com'; }
  function approved() { return request.auth != null && request.auth.token.email_verified == true && (instructor() || get(/databases/$(database)/documents/students/$(request.auth.uid)).data.status == 'approved'); }
  match /students/{uid} {
   allow read: if request.auth != null && (request.auth.uid == uid || instructor());
   allow write: if false;
   match /{record=**} { allow read: if approved() && (request.auth.uid == uid || instructor()); allow write: if false; }
  }
  match /books/{book} { allow read: if approved(); allow write: if false; }
  match /attempts/{attempt} { allow read: if approved() && (resource.data.uid == request.auth.uid || instructor()); allow write: if false; }
  match /{document=**} { allow read, write: if false; }
 }
}
